ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://arbitra:local-only@localhost:5432/arbitra
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=8
POOL_SIZE=5
POOL_OVERFLOW=5
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM=IF-Arbitra <nao-responda@example.edu.br>
SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Configure o cadastro privado no ambiente do comando de seed/deploy:
# IF_ARBITRA_ROSTER_PATH=/caminho/privado/initial_roster.json
# ou IF_ARBITRA_ROSTER_JSON={...}

# Tests refuse databases whose names do not end in _test.
TEST_DATABASE_URL=postgresql+psycopg://arbitra:local-only@localhost:5432/arbitra_test
