ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://arbitra:local-only@localhost:5432/arbitra
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=8
POOL_SIZE=5
POOL_OVERFLOW=5

# Tests refuse databases whose names do not end in _test.
TEST_DATABASE_URL=postgresql+psycopg://arbitra:local-only@localhost:5432/arbitra_test
